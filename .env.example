# PostgreSQL Database Connection Configurations
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_DATABASE=stayease_db
DB_SSL=false

# Alternatively, you can use a unified database connection URL:
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Outbound Mail SMTP configurations (Optional, uncomment to enable real email sending)
# SMTP_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SENDER=StayEase PG <your-email@gmail.com>
